{
  "fires": [],
  "why": "GitHub layers rulesets: every active ruleset matching a ref contributes, and the ref is governed by the union. A Project that files the same rules under two names is protected, and demanding one named `protect-main` would be auditing a filing convention rather than a control.",
  "rulesets": {
    "protect-main": { "rules": [{ "type": "pull_request", "parameters": { "required_approving_review_count": 0 } }] },
    "+no-rewriting-history": {
      "id": 3,
      "name": "no-rewriting-history",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
      "rules": [
        { "type": "deletion" },
        { "type": "non_fast_forward" },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": true,
            "required_status_checks": [{ "context": "test" }, { "context": "contract / tier-1" }]
          }
        }
      ]
    }
  }
}
